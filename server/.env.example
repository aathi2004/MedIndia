# Server configuration
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_ehr

# JWT signing secret — change in production
JWT_SECRET=dev-secret-change-me-in-production

# CORS origin for the frontend
CLIENT_URL=http://localhost:5173

# Optional: OpenAI-compatible API key for AI clinical note summarisation.
# If unset, the server uses a built-in deterministic summariser.
AI_API_KEY=
AI_API_BASE_URL=