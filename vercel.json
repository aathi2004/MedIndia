{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/src/generated-client/**",
          "client/dist/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/api/index.ts"
    },
    {
      "source": "/api",
      "destination": "/server/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/server/api/index.ts"
    }
  ]
}